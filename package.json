{
  "name": "t3wow",
  "version": "0.14.0",
  "t3Code": "0.1.12",
  "license": "MIT",
  "private": true,
  "description": "T3 Code inside World of Warcraft: Forever.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test tests/*.test.js && cargo test --manifest-path companion/Cargo.toml",
    "test:addon": "node --test tests/*.test.js",
    "test:live": "cargo test --manifest-path companion/Cargo.toml bridge::tests::live:: -- --ignored --test-threads=1 && node --test tests/live-replay.js",
    "build:exe": "node scripts/build-exe.mjs",
    "build:app": "node scripts/build-app.mjs",
    "screenshots": "node scripts/screenshots/render.mjs"
  },
  "devDependencies": {
    "fengari": "^0.1.5"
  }
}
